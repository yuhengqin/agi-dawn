# AGI黎明。本机配置：node scripts/init-env.ts；密钥只在后端，不提交 .env。
SITE_URL=http://localhost:3000
ADMIN_PASSWORD=
SESSION_SECRET=
POSTGRES_PASSWORD=

# 所有外部动作默认关闭；只有字符串 true 才启用。
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=

# 新收录外文全文自动翻译。部署后运行 init-reader-translation 初始化预算，再开启模型调用。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_JSON_MODE=true
# LLM_EXTRA_JSON={}
# LLM_REASONING_TOKENS=0

# 可选付费提取服务，沿用回执与预算限制。
# SOCIALDATA_API_KEY=
# DAJIALA_KEY=
# JINA_API_KEY=
# GITHUB_TOKEN=
# INGEST_TOKEN=
# INGEST_RATE_LIMIT=10

# 内部告警/反馈，以及可选飞书管理员登录。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# FEISHU_ALERT_WEBHOOK_URL=
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=
# ALERT_QUIET_MINUTES=360

# 出站代理和管理员明确配置的内网订阅主机；文章/图片仍检查公开地址。
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# curl_cffi 浏览器指纹传输：本机默认 .data/curl-cffi/bin/python，安装见 docs/deploy.md。
# CURL_CFFI_PYTHON=/opt/curl-cffi/bin/python
# PRIVATE_FEED_HOSTS=rsshub
# 信源图标下载流量预算（分钟 MB / 日 GB）。
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
TRUST_PROXY=false

# 配套数据库与归档资源备份。未配云存储时可显式执行本地备份。
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# AGIDawn_RELEASE=
# AGIDawn_ENVIRONMENT=
# 可按 collectors.env、integrations.env、auth.env 分组存放密钥。
# AGIDawn_CREDENTIALS_DIR=

# Linux 本机进程运行时设置；Docker compose 提供相应地址。
# DATABASE_URL=postgres://用户名@127.0.0.1:5432/reader_dev
# API_BASE_URL=http://127.0.0.1:3001
# AGIDawn_DATA_DIR=/var/lib/agi-dawn
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# ALLOW_PRIVATE_NETWORK_FETCH=true
# SITE_DOMAIN=example.com
# PORT=127.0.0.1:3000
